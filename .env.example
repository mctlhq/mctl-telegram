# mctl-telegram — environment configuration
# Copy to .env and fill in the values.
# Never commit .env to version control.

# Server
ADDR=:8080
PUBLIC_BASE_URL=https://tg.example.com

# Auth
AUTH_MODE=local-jwt
AUTH_REQUIRED=true

# JWT signing key for local-jwt mode (HS256).
# Generate: openssl rand -base64 64
# Must persist across restarts and be unique to this deployment.
OAUTH_JWT_SIGNING_KEY=

# Token lifetimes (optional — defaults shown)
# OAUTH_ACCESS_TOKEN_TTL=1h
# OAUTH_REFRESH_TOKEN_TTL=720h

# Telegram API credentials (https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Telegram OIDC login bot (created via BotFather)
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_LOGIN_BOT_TOKEN=

# Session encryption key — 32 random bytes, hex-encoded.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Database
# For docker-compose, DATABASE_URL is set automatically by the compose file.
# SQLite (local dev without Docker):
# DATABASE_URL=file:./mctl-telegram.db?_pragma=journal_mode(WAL)
# Postgres:
DATABASE_URL=postgres://mctl:${POSTGRES_PASSWORD}@localhost:5432/mctl_telegram?sslmode=disable

# Postgres password — used by docker-compose for both the app and the db service.
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# Send gate — keep false until you have validated the send path
ALLOW_SEND=false

# Operator identity (used in local-dev auth mode only)
# OPERATOR_GITHUB_LOGIN=your-github-handle

# Reviewer/demo auth-mode (ChatGPT App Directory review only).
# When enabled, /oauth/authorize shows a password-gated "reviewer access" form
# that signs in as a pre-provisioned demo Telegram account (DEMO_REVIEWER_TG_ID)
# WITHOUT the live Telegram OIDC login (no phone/SMS). The demo account must
# already have an active MTProto session and client tier; keep ALLOW_SEND=false
# and the account's send_enabled=false so every send is a dry-run preview.
# Turn this OFF again after the review and rotate the password.
# DEMO_REVIEWER_ENABLED=false
# DEMO_REVIEWER_USERNAME=
# DEMO_REVIEWER_PASSWORD=
# DEMO_REVIEWER_TG_ID=
