{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.3.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "description": "Operational dashboard for mctl-telegram beta tier. Covers traffic, session pool, Telegram pressure, session lifecycle, OAuth, and rate limiting.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "title": "Traffic",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Requests per second by chi route pattern and HTTP status code. High 5xx rate or sudden drop signals handler failures.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "id": 2,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(mctl_http_requests_total{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{route}} {{status_code}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "MCP tool calls per second, split by tool name and outcome (ok / error). Spike in error series often precedes FloodWait events.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "id": 3,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(mctl_tool_invocations_total{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{tool}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "MCP tool invocations",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Wall-clock latency percentiles per MCP tool. Histograms use fixed buckets [0.05,0.1,0.25,0.5,1,2.5,5,10] seconds (defined in metrics.go).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "id": 4,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(mctl_tool_invocation_duration_seconds_bucket{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50 {{tool}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mctl_tool_invocation_duration_seconds_bucket{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95 {{tool}}",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.99, sum by (le, tool) (rate(mctl_tool_invocation_duration_seconds_bucket{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99 {{tool}}",
          "refId": "C"
        }
      ],
      "title": "Tool invocation duration p50/p95/p99",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 5,
      "title": "Session pool",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Live MTProto client pool entries versus the configured TELEGRAM_MAX_SESSIONS cap. A -1 capacity line means the pool is uncapped.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 10},
      "id": 6,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "mctl_telegram_client_pool_size{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "pool size {{pod}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "mctl_telegram_pool_capacity{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "capacity {{pod}}",
          "refId": "B"
        }
      ],
      "title": "Pool size vs capacity",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Session pool fill fraction. Meaningful only when TELEGRAM_MAX_SESSIONS > 0 (capacity > 0). Used as the HPA signal; see docs/hpa.md. When the pool is uncapped (capacity = -1), clamp_min prevents a divide-by-zero but the resulting value is not operationally meaningful.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 85}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 10},
      "id": 7,
      "options": {
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "mctl_telegram_client_pool_size{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"} / clamp_min(mctl_telegram_pool_capacity{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}, 1) * 100",
          "legendFormat": "utilization {{pod}}",
          "refId": "A"
        }
      ],
      "title": "Pool utilization %",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Rate of MTProto client goroutine exits with a non-context-canceled error. Non-zero baseline here usually means Telegram connectivity issues or auth-key corruption.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 10},
      "id": 8,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(mctl_telegram_client_errors_total{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "client errors {{pod}}",
          "refId": "A"
        }
      ],
      "title": "Client error rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 9,
      "title": "Telegram pressure",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Rate of Telegram FLOOD_WAIT_X errors by MCP tool. Each increment means a tool call was delayed by a server-side rate limit; sustained values > 0 indicate Telegram is throttling this account.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 19},
      "id": 10,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(mctl_telegram_flood_wait_events_total{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ],
      "title": "FloodWait events",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "id": 11,
      "title": "Sessions lifecycle",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Non-revoked sessions last used within the past hour. Refreshed every minute by a background sampler in main(). Sudden drop may indicate a bulk revocation or session sweep.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
      "id": 12,
      "options": {
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "mctl_sessions_active{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "active {{pod}}",
          "refId": "A"
        }
      ],
      "title": "Active sessions",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Rate of new Telegram sessions persisted via SaveSession. Each increment corresponds to a user successfully completing Telegram login.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
      "id": 13,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(mctl_sessions_connected_total{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "new sessions {{pod}}",
          "refId": "A"
        }
      ],
      "title": "New sessions rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Revocations per second by reason: disconnect, delete, idle_expiry (30d), absolute_expiry (90d). Spikes in idle_expiry are expected during quiet periods.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
      "id": 14,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(mctl_sessions_revoked_total{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Session revocation rate by reason",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36},
      "id": 15,
      "title": "OAuth",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Count of in-flight OAuth authorization flows. Refreshed every minute. A sustained non-zero value with no corresponding traffic may indicate abandoned flows or bot-scan activity against /oauth/authorize (see docs/hpa.md).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 20}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 37},
      "id": 16,
      "options": {
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "mctl_oauth_pending_auth_size{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}",
          "legendFormat": "pending flows {{pod}}",
          "refId": "A"
        }
      ],
      "title": "Pending OAuth flows",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Authentication failures per second by failure reason and provider. Elevated values may indicate misconfigured tokens, clock skew, or brute-force attempts.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 37},
      "id": 17,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(mctl_auth_failures_total{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{reason}} / {{provider}}",
          "refId": "A"
        }
      ],
      "title": "Auth failure rate by reason",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 45},
      "id": 18,
      "title": "Rate limiting",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "HTTP 429 responses issued by the rate limiter per second, split by identity_kind (user / anon). High anon rate may indicate unauthenticated scanning; high user rate may indicate a runaway MCP client.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 46},
      "id": 19,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(mctl_rate_limit_events_total{namespace=\"$namespace\",pod=~\"$pod\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{identity_kind}}",
          "refId": "A"
        }
      ],
      "title": "Rate limit events by identity kind",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mctl", "beta", "telegram"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(mctl_http_requests_total, namespace)",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "namespace",
        "options": [],
        "query": {
          "query": "label_values(mctl_http_requests_total, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Namespace"
      },
      {
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(mctl_http_requests_total{namespace=\"$namespace\"}, pod)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "pod",
        "options": [],
        "query": {
          "query": "label_values(mctl_http_requests_total{namespace=\"$namespace\"}, pod)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Pod"
      },
      {
        "current": {},
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "definition": "label_values(mctl_http_requests_total{namespace=\"$namespace\",pod=~\"$pod\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(mctl_http_requests_total{namespace=\"$namespace\",pod=~\"$pod\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Instance"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "mctl-telegram Beta",
  "uid": "mctl-telegram-beta",
  "version": 1
}
