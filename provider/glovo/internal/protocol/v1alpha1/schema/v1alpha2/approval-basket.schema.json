{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mctl.ai/schemas/bridge/v1alpha2/approval-basket.schema.json",
  "title": "Approval basket (the canonical projection a human approves), v1alpha2",
  "description": "basket_fingerprint = 'sha256:' + hex(SHA-256(JCS(approval_basket))). Not expressible here and checked by the reference validator: lines sorted ascending by item_code, item_code unique, subtotal_minor = sum(quantity * unit_price_minor), total_minor = subtotal_minor + delivery_fee_minor + service_fee_minor - discount_minor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "store_ref",
    "currency",
    "lines",
    "subtotal_minor",
    "delivery_fee_minor",
    "service_fee_minor",
    "discount_minor",
    "total_minor"
  ],
  "properties": {
    "v": {
      "const": "mctl-approval-basket/v1"
    },
    "store_ref": {
      "type": "string",
      "pattern": "^pst_[A-Za-z0-9]{16,40}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_code",
          "quantity",
          "unit_price_minor"
        ],
        "properties": {
          "item_code": {
            "$ref": "#/$defs/item_code"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    },
    "subtotal_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3000000000
    },
    "delivery_fee_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "service_fee_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "discount_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "total_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3020000000
    }
  },
  "$defs": {
    "item_code": {
      "type": "string",
      "pattern": "^FAKE-[A-Z0-9-]{1,32}$"
    }
  }
}
